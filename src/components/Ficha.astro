---
import { ficha, perfil } from "../data/portfolio";
---

<section aria-labelledby="ficha-titulo" class="bg-carbon text-hueso">
  <div class="contenedor grid grid-cols-[502fr_486fr] gap-x-8 py-20 max-lg:grid-cols-1 max-lg:justify-items-center max-lg:gap-y-14 max-sm:py-14">
    <div class="w-full max-w-[502px]">
      <div class="foto relative z-10 aspect-[502/664] border-8 border-hueso bg-grafito transition-transform duration-300 ease-out motion-safe:hover:scale-[1.02] motion-safe:hover:-rotate-2"></div>
      <p class="-mt-1 flex h-[59px] w-[96.8%] items-center justify-between bg-naranja px-[18px] text-barra">
        <span>{perfil.nombre}</span>
        <span class="text-lima">{perfil.numero}</span>
      </p>
    </div>

    <div class="w-full max-w-[486px]">
      <h2 id="ficha-titulo" class="text-titulo">
        {ficha.titulo}
      </h2>
      <dl class="mt-5 border-t-2 border-hueso">
        {ficha.filas.map((fila) => (
          <div class="flex min-h-[41px] items-baseline justify-between gap-4 border-b border-hueso/20 pt-[10.5px] pb-1.5">
            <dt class="text-etiqueta text-hueso/75">{fila.etiqueta}</dt>
            <dd class="text-right text-valor">{fila.valor}</dd>
          </div>
        ))}
      </dl>
      <ul class="mt-8 grid grid-cols-3 gap-2.5 max-sm:grid-cols-2">
        {ficha.estadisticas.map((estadistica) => (
          <li class="border-2 border-hueso px-3.5 py-4 transition-colors duration-200 hover:bg-naranja">
            <p class="text-numero">{estadistica.valor}</p>
            <p class="mt-2 text-etiqueta">{estadistica.etiqueta}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
