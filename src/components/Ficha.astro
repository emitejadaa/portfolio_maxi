---
import { ficha, perfil } from "../data/portfolio";
---

<section aria-labelledby="ficha-titulo" class="bg-carbon text-hueso">
  <div class="contenedor grid grid-cols-[502fr_486fr] gap-x-8 py-20">
    <div>
      <div class="foto relative z-10 aspect-[502/664] border-8 border-hueso bg-grafito"></div>
      <p class="-mt-1 flex h-[59px] w-[96.8%] items-center justify-between bg-naranja px-[18px] text-barra">
        <span>{perfil.nombre}</span>
        <span class="text-lima">{perfil.numero}</span>
      </p>
    </div>

    <div>
      <h2 id="ficha-titulo" class="text-titulo">
        {ficha.titulo}
      </h2>
      <dl class="mt-5 border-t-2 border-hueso">
        {ficha.filas.map((fila) => (
          <div class="flex h-[41px] items-baseline justify-between gap-4 border-b border-hueso/20 pt-[10.5px]">
            <dt class="text-etiqueta text-hueso/75">{fila.etiqueta}</dt>
            <dd class="text-right text-valor">{fila.valor}</dd>
          </div>
        ))}
      </dl>
      <ul class="mt-8 grid grid-cols-3 gap-2.5">
        {ficha.estadisticas.map((estadistica) => (
          <li class="border-2 border-hueso px-3.5 py-4">
            <p class="text-numero">{estadistica.valor}</p>
            <p class="mt-2 text-etiqueta">{estadistica.etiqueta}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
