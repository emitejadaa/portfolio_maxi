    <p class="text-cierre max-md:text-[3.25rem] max-sm:text-[2.75rem]">
      <span class="block text-hueso">{cierre.frase}</span>
      <span class="block text-lima">{cierre.remate}</span>
    </p>
  </div>
</section>
