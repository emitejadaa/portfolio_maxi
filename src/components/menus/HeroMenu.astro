---
import { Image } from "astro:assets";

import type { Pestana } from "../../data/menus";
import TituloVivo from "../TituloVivo.astro";

interface Props {
  pestana: Pestana;
}

const { pestana } = Astro.props;
const t = pestana.tema;
const tenis = t === "derrota" || t === "trofeos";
const textoOscuro = t === "liba" || t === "speakup";
const lineasTitulo = pestana.titulo.split("\n");
const lineasBajada = pestana.bajada.split("\n");

// Color de las letras del título y el que toman al pasar el cursor
const colorTitulo = {
  talento: "[--acento:var(--color-lima)] [--base:var(--color-hueso)]",
  derrota: "[--acento:var(--color-lima)] [--base:var(--color-hueso)]",
  trofeos: "[--acento:var(--color-lima)] [--base:var(--color-hueso)]",
  liba: "[--acento:var(--color-hueso)] [--base:var(--color-carbon)]",
  speakup: "[--acento:var(--color-naranja)] [--base:var(--color-carbon)]",
  hide: "[--acento:var(--color-lima)] [--base:var(--color-hueso)]",
  udesa: "[--acento:var(--color-lima)] [--base:var(--color-hueso)]",
}[t];

const fondo = {
  talento: "bg-carbon md:min-h-[395px] pt-[76px] pb-[76px]",
  derrota: "bg-ladrillo md:min-h-[351px] pt-[72px] pb-[75px]",
  trofeos: "bg-naranja md:min-h-[430px] pt-[72px] pb-[75px]",
  liba: "fondo-madera bg-madera md:min-h-[481.5px] py-[72px]",
  speakup: "bg-lima md:min-h-[481.5px] py-[72px]",
  hide: "bg-noche md:min-h-[505.5px] pt-[88px] pb-[64px]",
  udesa: "fondo-plano bg-plano md:min-h-[513.3px] pt-20 pb-[79px]",
}[t];

const volanta = {
  talento: "pl-3 font-tiza text-[1.5rem] text-hueso",
  derrota: "h-[34px] bg-carbon px-3 text-[0.8rem] font-bold text-hueso",
  trofeos: "h-[34px] bg-carbon px-3 text-[0.8rem] font-bold text-hueso",
  liba: "h-[34px] bg-naranja-liba px-3 text-[0.8rem] font-bold text-carbon",
  speakup:
    "h-[34px] rounded-full bg-carbon px-3.5 text-[0.8rem] font-bold text-hueso",
  hide: "h-[30px] bg-naranja-oscuro px-3 font-pixel text-[0.625rem] text-hueso",
  udesa: "pl-3 text-[0.9375rem] font-bold text-hueso",
}[t];

const marcadorVolanta = {
  talento: "bg-hueso",
  derrota: "bg-lima",
  trofeos: "bg-lima",
  liba: "bg-carbon",
  speakup: "rounded-full bg-lima",
  hide: "bg-lima",
  udesa: "bg-lima",
}[t];
---

<section
  aria-labelledby="titulo-pestana"
  class:list={["relative overflow-hidden", fondo]}
>
  <!-- Decoración de fondo, a todo el ancho -->
  {t === "talento" && (
    <div
      aria-hidden="true"
      class="absolute inset-y-0 left-0 w-[35px] bg-pizarron"
    />
  )}
  {(tenis || t === "liba" || t === "udesa") && (
    <div
      aria-hidden="true"
      class:list={[
        "pointer-events-none absolute inset-5",
        t === "liba"
          ? "border-3 border-sombra"
          : t === "udesa"
            ? "border-2 border-hueso"
            : "border-3 border-hueso/50",
      ]}
    />
  )}
  {tenis && (
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-5 bottom-[47px] h-[3px] bg-hueso/50"
    />
  )}
  {t === "hide" && (
    <div
      aria-hidden="true"
      class="grilla-juego absolute inset-x-0 bottom-0 h-[111px]"
    />
  )}

  <!-- Decoración ubicada sobre el frame de 1100 px del diseño -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 mx-auto max-w-[68.75rem] max-md:hidden"
  >
    {t === "talento" && (
      <>
        <span class="absolute top-[57px] left-[684px] font-tiza text-[3rem] text-hueso/20">
          a² + b² = c²
        </span>
        <span class="absolute top-[45px] left-[948px] text-[7.5rem] leading-none font-light text-hueso/20">
          ∑
        </span>
        <span class="absolute top-[287px] left-[836px] font-tiza text-[3.5rem] text-hueso/20">
          √x² = |x|
        </span>
      </>
    )}
    {tenis && (
      <svg class="absolute top-9 left-[926px] size-[54px]" viewBox="0 0 54 54">
        <circle cx="27" cy="27" r="27" fill="var(--color-lima)" />
        <path
          d="M7 9c9 7 9 29 0 36M47 9c-9 7-9 29 0 36"
          fill="none"
          stroke="var(--color-hueso)"
          stroke-width="2.5"
        />
      </svg>
    )}
    {t === "liba" && (
      <>
        <span class="absolute top-[27.7px] left-[787px] size-[426px] rounded-full border-3 border-sombra" />
        <span class="absolute top-[137.7px] left-[907px] h-[206px] w-[176px] border-3 border-sombra" />
      </>
    )}
    {t === "hide" && (
      <div class="absolute top-[19px] right-20 left-20 flex justify-between font-pixel text-[0.6875rem] text-lima">
        <span>Jugador 1</span>
        <span class="flex gap-2">
          {[0, 1, 2].map(() => (
            <svg
              viewBox="0 0 7 6"
              class="h-[9px] w-[11px] fill-current"
              shape-rendering="crispEdges"
            >
              <path d="M1 0h2v1h1V0h2v1h1v2H6v1H5v1H4v1H3V5H2V4H1V3H0V1h1z" />
            </svg>
          ))}
        </span>
        <span>Puntaje 001000</span>
      </div>
    )}
    {t === "udesa" && (
      <div class="absolute top-[410.8px] right-5 bottom-5 left-[866.6px] border-t-2 border-l-2 border-hueso px-[18px] py-[13px] text-[0.8125rem] leading-[20px] font-medium text-hueso">
        <p>Plano Nº 05</p>
        <p>Ing. Industrial · UdeSA</p>
        <p>Escala 1:1</p>
      </div>
    )}
  </div>

  <div class="contenedor relative">
    <div
      class:list={[
        "px-5 md:px-10",
        pestana.imagen &&
          "grid gap-10 md:grid-cols-[minmax(0,1fr)_450px] md:items-center",
        t === "udesa" && "md:!items-start",
      ]}
    >
      <div>
        <p class:list={["inline-flex items-center gap-2.5", volanta]}>
          <span
            aria-hidden="true"
            class:list={["size-2 shrink-0", marcadorVolanta]}
          />
          {pestana.volanta}
        </p>
        <TituloVivo
          id="titulo-pestana"
          lineas={lineasTitulo}
          class:list={[
            t === "hide"
              ? "mt-[22px] font-pixel text-[2.875rem] leading-[48px] [text-shadow:4px_4px_0_var(--color-naranja)] [--corrimiento:-0.08em] [--origen:92%] max-sm:text-[2rem] max-sm:leading-[38px]"
              : "text-[4.5rem] leading-[1.11] font-black tracking-[-0.02em] [--corrimiento:-0.08em] [--origen:82.8%] max-md:text-[3.25rem] max-sm:text-[2.6rem]",
            t === "talento"
              ? "mt-[30px]"
              : t === "udesa"
                ? "mt-5"
                : t !== "hide" && "mt-[22px]",
            colorTitulo,
          ]}
        />
        <p
          class:list={[
            "mt-[17px] max-w-[540px] text-[1.17rem] leading-[27px] font-bold",
            textoOscuro ? "text-carbon" : "text-hueso",
          ]}
        >
          {lineasBajada.map((linea, i) =>
            i === 0 ? (
              linea
            ) : (
              <>
                {" "}
                <br class="max-md:hidden" />
                {linea}
              </>
            ),
          )}
        </p>
      </div>

      {pestana.imagen && (
        <div class="relative w-full max-w-[450px]">
          <div
            class:list={[
              "relative aspect-[450/337.5] overflow-hidden",
              (t === "liba" || t === "speakup") &&
                "rounded-[26px] border-8 border-carbon bg-[#dfdfdf]",
              t === "hide" &&
                "border-8 border-lima bg-piedra shadow-[8px_8px_0_var(--color-naranja)]",
              t === "udesa" && "border-8 border-hueso bg-hueso",
            ]}
          >
            <Image
              src={pestana.imagen.src}
              alt={pestana.imagen.alt}
              widths={[434, 868]}
              sizes="(min-width: 768px) 434px, 100vw"
              loading="eager"
              class="size-full object-cover"
            />
          </div>
          {t === "hide" && (
            <span
              aria-hidden="true"
              class="absolute top-[46%] -left-[60px] h-[24px] w-[62px] rounded-[50%] bg-[#8f8f8f] opacity-80 blur-[1.5px] max-md:hidden"
            />
          )}
          {t === "speakup" && (
            <div aria-hidden="true" class="max-md:hidden">
              <span class="burbuja -top-2 right-[9px] bg-piedra">Hola</span>
              <span class="burbuja top-[120px] -left-[13px] bg-carbon text-hueso">
                Quiero agua
              </span>
              <span class="burbuja top-[236px] -right-[16px] bg-piedra">
                Gracias
              </span>
            </div>
          )}
          {t === "hide" && (
            <svg
              aria-hidden="true"
              class="absolute -top-[22px] right-[52px] h-6 w-[112px] max-md:hidden"
              viewBox="0 0 112 24"
            >
              {[0, 1, 2, 3, 4, 5, 6, 7].map((k) => {
                const a = Math.PI * (1 - k / 7);
                return (
                  <circle
                    cx={56 + 50 * Math.cos(a)}
                    cy={22 - 18 * Math.sin(a)}
                    r="3"
                    fill="var(--color-lima)"
                  />
                );
              })}
            </svg>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .fondo-madera {
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent 0 46px,
        rgb(0 0 0 / 0.05) 46px 48px
      ),
      linear-gradient(90deg, rgb(255 255 255 / 0.04), rgb(0 0 0 / 0.04));
  }

  .fondo-plano {
    background-image:
      linear-gradient(rgb(242 242 240 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(242 242 240 / 0.07) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .grilla-juego {
    background-image:
      radial-gradient(
        circle at 50% 100%,
        rgb(212 232 58 / 0.14),
        transparent 60%
      ),
      linear-gradient(rgb(212 232 58 / 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgb(212 232 58 / 0.18) 1px, transparent 1px);
    background-size:
      100% 100%,
      46px 23px,
      46px 23px;
    mask-image: linear-gradient(to bottom, transparent, black 70%);
  }

  .burbuja {
    position: absolute;
    border: 3px solid var(--color-carbon);
    border-radius: 18px;
    padding: 0.55rem 1rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }
</style>
