---
import { perfil } from "../data/portfolio";
---

<header class="relative bg-naranja text-hueso">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-5 border-[3px] border-hueso/50"
  ></div>
  <div class="contenedor relative">
    <div class="px-6 pt-[47px] pb-[61px] max-sm:pt-9 max-sm:pb-12">
      <h1
        class="wordmark flex w-fit items-baseline leading-none font-black"
        aria-label={perfil.nombre}
      >
        <span aria-hidden="true" class="letra letra-m">
          M
        </span>
        <span aria-hidden="true" class="letra letra-a">
          a
        </span>
        <span aria-hidden="true" class="letra letra-x">
          x
        </span>
        <span aria-hidden="true" class="letra letra-i">
          i
        </span>
      </h1>
      <div aria-hidden="true" class="mt-[25px] h-[3px] bg-hueso"></div>
      <ul class="mt-[18px] flex flex-wrap gap-x-8 gap-y-2 max-sm:gap-x-6">
        {perfil.tags.map((tag) => (
          <li class="flex items-center gap-3 text-tag transition-colors duration-200 hover:text-lima max-sm:text-[1.25rem]">
            <span
              aria-hidden="true"
              class="size-3 shrink-0 rounded-full bg-lima"
            />
            {tag}
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<style>
  /*
   * En el diseño cada letra tiene su propio tamaño y su propia línea base
   * (M 151,4 px, a 158,6 px +2, x 145,3 px −3, i 160 px +3). Todo va en em
   * sobre el tamaño de la "i" para que el wordmark escale entero.
   */
  .wordmark {
    /* 160 px en desktop; en pantallas chicas escala con el ancho */
    font-size: clamp(5.5rem, 30vw, 10rem);
  }

  .letra {
    display: inline-block;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.2s ease;
  }

  .letra-m {
    font-size: 0.94625em;
  }

  /* Inter v4 dibuja la M y la x en Black 3 y 2 px más anchas que el
     diseño: los márgenes devuelven cada letra a su posición. */
  .letra-a {
    margin-inline-start: -0.019em;
    font-size: 0.99125em;
    transform: translateY(0.0126em);
    /* Origen del glifo: borde izquierdo sobre la línea base */
    transform-origin: 0 86.33%;
  }

  .letra-x {
    margin-inline-start: -0.007em;
    font-size: 0.908125em;
    transform: translateY(-0.0206em);
  }

  .letra-i {
    margin-inline-start: -0.006em;
    transform: translateY(0.01875em);
  }

  /*
   * Hover (solo con puntero, como las variantes hover: de Tailwind): la "a"
   * pasa a lima, rota y se adelanta; la "x" y la "i" la siguen.
   */
  @media (hover: hover) {
    .wordmark:hover .letra-a {
      color: var(--color-lima);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .wordmark:hover .letra-a {
      transform: translate(-0.056em, -0.0756em) rotate(-6deg);
    }

    .wordmark:hover .letra-x {
      transform: translate(-0.1825em, -0.0206em);
    }

    .wordmark:hover .letra-i {
      transform: translate(-0.1933em, 0.01875em);
    }
  }
</style>
