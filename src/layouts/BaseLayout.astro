---
import "@fontsource-variable/inter";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Maximiliano Nudelman · Portfolio",
  description = "Portfolio de Maximiliano Nudelman: matemática, lógica, tenis y los proyectos que lidera. Del talento a la constancia.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#c4562e" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Maxi · Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Wordmark «Maxi» sobre fondo naranja con los tags Matemática, Lógica, Deporte y Gestión"
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/movimiento";
    </script>
  </body>
</html>
